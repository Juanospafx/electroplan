<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # No redirigir nada de backend
    RewriteCond %{REQUEST_URI} ^/backend/ [NC]
    RewriteRule .* - [L]

    # Si no existe archivo o carpeta real
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ public [L]
</IfModule>
